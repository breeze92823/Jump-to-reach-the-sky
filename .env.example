# Skips the Bloxity SDK (sdk.bloxity.io) and avatar CDN (static.bloxity.io) so local dev never depends on them.
VITE_DEV_MODE=false

# Dev only (`npm run dev`): the game server to connect to (backend: ../Jump-to-reach-the-sky-backend, `npm start`).
# Defaults to ws://localhost:2567; set it empty to run without a server (progress then stays in localStorage).
# Deployed builds ignore this and find the server through the Bloxity matchmaker.
VITE_SERVER_URL_DEV=ws://localhost:2567
